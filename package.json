{
  "name": "bitmake",
  "version": "0.0.1-develop.15",
  "description": "BitMake builds your code with the flexibility of JS-defined rules",
  "author": "Yurii Yakubin",
  "homepage": "https://github.com/yacubin/bitmake#readme",
  "license": "MIT",
  "main": "./dist/bitmake.js",
  "types": "./dist/bitmake.d.ts",
  "exports": "./dist/bitmake.js",
  "bin": {
    "bitmake": "./dist/bitmake.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "dts-bundle-generator --config dtsconfig.js",
    "build:debug": "webpack --config webpack.config.mjs --mode development && npm run build:types",
    "build:release": "webpack --config webpack.config.mjs --mode production && npm run build:types",
    "test": "jest --config=jest.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacubin/bitmake.git"
  },
  "bugs": {
    "url": "https://github.com/yacubin/bitmake/issues",
    "email": "yurii.yakubin@gmail.com"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/babel__generator": "^7.27.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "dts-bundle-generator": "^9.5.1",
    "html-webpack-inline-source-plugin": "^0.0.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-jest-mock-import-meta": "^1.3.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1"
  }
}
